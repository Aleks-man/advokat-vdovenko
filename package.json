{
  "name": "advokat-vdovenko",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev": "concurrently -n front,back -c green,blue \"npm run dev -w front\" \"npm run dev -w back\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w back",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
